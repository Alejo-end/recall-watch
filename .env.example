# Copy this file to .env. Git ignores .env. Never commit it.
# The key from context.dev/dashboard/api-keys. Redeem the team code first (see HANDBOOK.md).
CONTEXT_DEV_API_KEY=
# Optional: only for webhooks, which need an address that the internet can reach.
# CONTEXT_WEBHOOK_SECRET=

# Optional: Kimi is a second-model source-grounding reviewer for a human audit. It never changes
# a Recall Watch hold or verification result. Create an Inference API key in Verda, not a Cloud API credential.
# VERDA_INFERENCE_BASE_URL=https://inference.verda.com
# VERDA_INFERENCE_API_KEY=
# VERDA_MODEL=kimi-k3-1-pro

# Optional: operator key. If set, every change on the Recall Watch screen needs it (header field).
# If not set, only this computer can make changes; other devices on the network can only view.
# AFTERIMAGE_WRITE_KEY=
# Optional: the "Open on your phone" card. The network name and password are shown on the screen
# for people in the room. Leave them empty to show only the address.
# SHARE_WIFI_SSID=
# SHARE_WIFI_PASSWORD=
# SHARE_WIFI_SECURITY=WPA
# SHARE_URL=http://192.168.1.20:8030/
# Optional: a GitHub token for the live proof's test page (recall/proof.py). Without it the app
# uses the token of `gh auth login`.
# GITHUB_TOKEN=
# Optional: KITCHEN=1 runs the poller of the earlier kitchen shelf prototype. It spends Context.dev credits.
# KITCHEN=1
